# Настройки сервиса. Скопируйте в .env и подставьте свои значения.
# На Windows указывайте 127.0.0.1, а не localhost: попытка соединения по IPv6 ::1 отнимает около 2 с.

KB_DATABASE_URL=postgresql+psycopg://kb:kb@127.0.0.1:5432/kb
# Без KB_REDIS_URL сервис работает, но результаты поиска не кэшируются.
KB_REDIS_URL=redis://127.0.0.1:6379/0
KB_CACHE_TTL_SECONDS=300
KB_CACHE_TIMEOUT_SECONDS=0.25
KB_LOG_LEVEL=INFO
# Выводить в журнал запросы SQL: для отладки.
KB_SQL_ECHO=false
