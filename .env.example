# Настройки сервиса. Для Docker файл создаётся командой: sh tools/init_env.sh
# Значения "заменить" этот скрипт заменяет случайными секретами. Файл .env в git не попадает.

# База данных и Redis в контейнерах
POSTGRES_USER=kb
POSTGRES_PASSWORD=заменить
POSTGRES_DB=kb
REDIS_PASSWORD=заменить

# Запуск без Docker: укажите адреса серверов. В compose.yaml эти значения задаются сами.
# На Windows указывайте 127.0.0.1, а не localhost: попытка соединения по IPv6 ::1 отнимает около 2 с.
# KB_DATABASE_URL=postgresql+psycopg://kb:kb@127.0.0.1:5432/kb
# KB_REDIS_URL=redis://127.0.0.1:6379/0

# Ключ подписи токенов, не короче 32 символов. Без него сервис не запустится.
KB_JWT_SECRET=заменить
KB_ACCESS_TOKEN_MINUTES=30
KB_REFRESH_TOKEN_DAYS=14
KB_ONE_TIME_TOKEN_MINUTES=30

# Адрес сервиса для ссылок в письмах
KB_PUBLIC_URL=https://localhost:8443
# Cookie передаётся только по HTTPS. Отключается лишь при разработке без TLS.
KB_COOKIE_SECURE=true
# Страницы /docs и /redoc. В открытой сети их можно отключить.
KB_DOCS_ENABLED=true

# Почта. Без KB_SMTP_HOST письма пишутся в журнал: это режим разработки.
KB_SMTP_HOST=mailpit
KB_SMTP_PORT=1025
KB_SMTP_STARTTLS=false
KB_SMTP_FROM=noreply@kb.example.org
# KB_SMTP_USER=
# KB_SMTP_PASSWORD=

KB_CACHE_TTL_SECONDS=300
KB_CACHE_TIMEOUT_SECONDS=0.25
KB_LOG_LEVEL=INFO
# Выводить в журнал запросы SQL: для отладки.
KB_SQL_ECHO=false

# Порты на компьютере
KB_HTTP_PORT=8080
KB_HTTPS_PORT=8443
